# 环境变量示例（复制为 .env 后按环境填写；任何环境都不得提交真实密钥）
# 环境分层：local / ci / staging / production（主基线 §20.2）

# ---- 通用 ----
# 环境标识（string，必填）：local | ci | staging | production
APP_ENV=local

# ---- 云端控制平面（services/control-plane）----
# PostgreSQL 连接串（string，local 必填；CI 由 service 容器注入）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/warehouse_control
# API 监听端口（int，可选，默认 8000）
CONTROL_PLANE_PORT=8000
# CORS 允许来源（逗号分隔，生产必须为明确域名白名单，禁止 *）
CORS_ORIGINS=http://localhost:3000

# ---- 本地工作台（apps/workbench-desktop）----
# 引擎提供方（string，可选：fake | local；M0 默认 fake，仅组合根读取）
WORKBENCH_ENGINE=fake
# FakeEngine fixture 路径（string，可选，默认仓库内 tests/fixtures/fake-analysis.json）
WORKBENCH_FAKE_FIXTURE=tests/fixtures/fake-analysis.json
# 本地数据目录（string，可选，默认 %LOCALAPPDATA%\WarehouseWorkbench\data）
WORKBENCH_DATA_DIR=

# ---- Web（apps/web）----
# Next.js 监听端口（int，可选，默认 3000）
WEB_PORT=3000
# API 基地址（string，可选，默认 http://localhost:8000）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
