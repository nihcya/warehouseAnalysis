{
  "components": {
    "schemas": {
      "AccountData": {
        "description": "账号信息（不含凭证字段）。",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login At"
          },
          "login_name": {
            "title": "Login Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          }
        },
        "required": [
          "account_id",
          "login_name",
          "role",
          "status"
        ],
        "title": "AccountData",
        "type": "object"
      },
      "AccountMeData": {
        "description": "当前账号上下文。",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountData"
          },
          "license": {
            "$ref": "#/components/schemas/LicenseData"
          },
          "tenant": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TenantData"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "account",
          "license"
        ],
        "title": "AccountMeData",
        "type": "object"
      },
      "AccountMeResponse": {
        "description": "``GET /account/me`` 响应。",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AccountMeData"
          }
        },
        "required": [
          "data"
        ],
        "title": "AccountMeResponse",
        "type": "object"
      },
      "AuthData": {
        "description": "登录 / 刷新响应载荷。",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountData"
          },
          "license": {
            "$ref": "#/components/schemas/LicenseData"
          },
          "tenant": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TenantData"
              },
              {
                "type": "null"
              }
            ]
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenData"
          }
        },
        "required": [
          "tokens",
          "account",
          "license"
        ],
        "title": "AuthData",
        "type": "object"
      },
      "DeviceData": {
        "description": "设备信息。",
        "properties": {
          "app_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          },
          "device_id": {
            "title": "Device Id",
            "type": "string"
          },
          "device_type": {
            "title": "Device Type",
            "type": "string"
          },
          "fingerprint": {
            "title": "Fingerprint",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "registered_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registered At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "tenant_id",
          "name",
          "device_type",
          "fingerprint",
          "status"
        ],
        "title": "DeviceData",
        "type": "object"
      },
      "DeviceListResponse": {
        "description": "设备列表响应。",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DeviceData"
            },
            "title": "Data",
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "title": "DeviceListResponse",
        "type": "object"
      },
      "DeviceRegisterRequest": {
        "description": "设备注册请求：``(tenant_id, fingerprint)`` 唯一，重复注册按幂等处理。",
        "properties": {
          "app_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          },
          "device_type": {
            "default": "DESKTOP",
            "title": "Device Type",
            "type": "string"
          },
          "fingerprint": {
            "title": "Fingerprint",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "fingerprint"
        ],
        "title": "DeviceRegisterRequest",
        "type": "object"
      },
      "DeviceRegisterResponse": {
        "description": "设备注册响应。",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/DeviceData"
          }
        },
        "required": [
          "data"
        ],
        "title": "DeviceRegisterResponse",
        "type": "object"
      },
      "ErrorBody": {
        "description": "统一错误体：``{\"error\": ...}`` 的内层字段。",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "统一错误响应。",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "/health 响应：应用状态、版本与控制库可达性。",
        "properties": {
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "database": {
            "title": "Database",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "app_version",
          "database"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LicenseData": {
        "description": "许可证与离线宽限期评估结果。\n\n``status`` 取值：``ACTIVE`` / ``GRACE`` / ``EXPIRED`` / ``REVOKED`` / ``MISSING``；\n``GRACE`` 表示已过期但仍在离线宽限期内，此时接口仍放行，UI 必须明示剩余天数。",
        "properties": {
          "days_remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days Remaining"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "grace_days": {
            "default": 0,
            "title": "Grace Days",
            "type": "integer"
          },
          "grace_ends_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grace Ends At"
          },
          "license_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License Id"
          },
          "max_devices": {
            "default": 0,
            "title": "Max Devices",
            "type": "integer"
          },
          "product_profile_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Profile Code"
          },
          "starts_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LicenseData",
        "type": "object"
      },
      "LoginRequest": {
        "description": "登录请求。\n\n``client_type`` 与 ``device_id`` 可选：桌面工作台注册设备后登录时带上，\n便于把会话与设备关联（Web 登录默认 WEB）。",
        "properties": {
          "client_type": {
            "default": "WEB",
            "title": "Client Type",
            "type": "string"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "description": "登录响应。",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AuthData"
          }
        },
        "required": [
          "data"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "LogoutData": {
        "description": "注销响应载荷（重复注销幂等成功）。",
        "properties": {
          "revoked": {
            "default": true,
            "title": "Revoked",
            "type": "boolean"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "LogoutData",
        "type": "object"
      },
      "LogoutResponse": {
        "description": "注销响应。",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LogoutData"
          }
        },
        "required": [
          "data"
        ],
        "title": "LogoutResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "刷新访问令牌请求。",
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RefreshResponse": {
        "description": "刷新响应（与登录同构，Refresh Token 已轮换）。",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AuthData"
          }
        },
        "required": [
          "data"
        ],
        "title": "RefreshResponse",
        "type": "object"
      },
      "SnapshotData": {
        "description": "状态流快照（SSE 首帧与轮询降级共用同一结构）。",
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceData"
            },
            "title": "Devices",
            "type": "array"
          },
          "event_id": {
            "title": "Event Id",
            "type": "integer"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "license": {
            "$ref": "#/components/schemas/LicenseData"
          },
          "pending_sync_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending Sync Count"
          },
          "tasks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "event_id",
          "generated_at",
          "license",
          "devices"
        ],
        "title": "SnapshotData",
        "type": "object"
      },
      "SnapshotResponse": {
        "description": "``GET /events/snapshot`` 响应（轮询降级入口）。",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SnapshotData"
          }
        },
        "required": [
          "data"
        ],
        "title": "SnapshotResponse",
        "type": "object"
      },
      "TenantData": {
        "description": "商户信息。",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "product_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Profile Id"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "name",
          "status"
        ],
        "title": "TenantData",
        "type": "object"
      },
      "TokenData": {
        "description": "令牌对。",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_at": {
            "format": "date-time",
            "title": "Refresh Expires At",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in",
          "refresh_expires_at"
        ],
        "title": "TokenData",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "云端控制平面 /api/v1：认证、账号、设备与状态流（M2）；心跳、任务、同步、配置与技术日志维持 stub（M3）",
    "title": "warehouse-control-plane",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account/me": {
      "get": {
        "description": "返回当前账号、商户与许可证评估结果（含离线宽限期状态）。",
        "operationId": "read_me_api_v1_account_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountMeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "当前账号上下文",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "校验账号密码并签发令牌对（Access 15 分钟 / Refresh 可轮换）。",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "账号登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "撤销当前会话；重复注销保持幂等成功（已撤销的会话也返回 200）。",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "退出登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "轮换 Refresh Token 并重签 Access Token；重放即撤销该账号全部会话。",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "刷新访问令牌",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/config": {
      "get": {
        "description": "拉取商户生效配置（stub：配置发布与验签属 M3）。",
        "operationId": "get_config_api_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "缺少或无效的凭证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "缺少所需 Scope"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "M0 未实现（stub）"
          }
        },
        "summary": "拉取配置（stub）",
        "tags": [
          "config"
        ]
      }
    },
    "/api/v1/devices": {
      "get": {
        "description": "列出当前商户的全部设备（数据范围由令牌 tenant_id 决定）。",
        "operationId": "list_devices_api_v1_devices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "设备列表",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/register": {
      "post": {
