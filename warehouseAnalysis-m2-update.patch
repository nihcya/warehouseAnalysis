-    """读取整数序列参数（容忍逗号分隔字符串），缺失时取默认值。"""
-    raw = parameters.get(key)
-    if raw is None:
-        return default
-    if isinstance(raw, str):
-        return tuple(int(item.strip()) for item in raw.split(",") if item.strip())
